    "lit": "^3.0.0"
  },
  "dependencies": {
    "@freesail/core": "^0.9.4",
    "@lit/context": "^1.1.0"
  },
  "devDependencies": {
    "lit": "^3.2.0",
    "vitest": "^4.0.18"
  },
  "author": {
    "name": "Thendral AI Ltd",
    "email": "support@thendral.ai",
    "url": "https://www.thendral.ai"
  },
  "license": "MIT"
