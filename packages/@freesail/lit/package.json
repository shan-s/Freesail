{
  "name": "@freesail/lit",
  "version": "0.9.4",
  "description": "Lit (lit-html/LitElement) frontend for Freesail A2UI SDK",
  "homepage": "https://www.freesail.ai",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
